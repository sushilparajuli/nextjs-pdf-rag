# ==========================================
# Google Gemini API
# ==========================================
# Required for Gemini chat generation and vector embeddings (gemini-embedding-2).
GOOGLE_GENERATIVE_AI_API_KEY="your_google_generative_ai_api_key_here"

# ==========================================
# Database (PostgreSQL / Neon with pgvector)
# ==========================================
# PostgreSQL connection string with pgvector support for document chunk and vector storage.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# Alternatively, you can use NEON_DATABASE_URL:
# NEON_DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ==========================================
# Clerk Authentication
# ==========================================
# Clerk keys for authentication, route middleware protection, and server actions.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional Clerk route redirects:
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/chat"
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/chat"